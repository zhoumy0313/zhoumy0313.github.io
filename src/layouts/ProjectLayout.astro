---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import ProjectGallery from "@components/ProjectGallery.astro";
import ProjectVideo from "@components/ProjectVideo.astro";
import { localize } from "@lib/content";
import { renderMarkdown } from "@lib/markdown";
import { withBase, type Locale } from "@lib/paths";
import { linkTypeLabel, tagLabel } from "@i18n/ui";
const { project, locale } = Astro.props as { project: CollectionEntry<"projects">; locale: Locale };
const data = project.data; const title = localize(data.title, locale); const summary = localize(data.summary, locale);
---
<BaseLayout title={title} description={summary} locale={locale}><article class="project-detail"><header class="project-header"><p class="section-kicker">{data.date.getFullYear()} · {data.tags.map((tag) => tagLabel(tag, locale)).join(" / ")}</p><h2>{title}</h2><p class="summary">{summary}</p>{data.links.length > 0 && <div class="project-links">{data.links.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label ? localize(link.label, locale) : linkTypeLabel(link.type, locale)}</a>)}</div>}</header><img class="cover" src={withBase(data.cover)} alt={title} />{data.video && <ProjectVideo video={data.video} title={title} />}<div class="prose" set:html={renderMarkdown(localize(data.body, locale))} />{data.gallery.length > 0 && <ProjectGallery images={data.gallery} locale={locale} />}</article></BaseLayout>
<style>.project-detail{display:grid;gap:1.5rem}.project-header h2{font-family:var(--font-serif);font-size:var(--title-size);line-height:1.08;margin:.1rem 0 .5rem}.summary{color:var(--muted);max-width:60ch}.project-links{display:flex;flex-wrap:wrap;gap:.75rem}.project-links a{background:var(--surface-strong);border-radius:999px;color:var(--ink);padding:.5rem .85rem;text-decoration:none}.cover{border-radius:1.25rem;max-width:100%}</style>

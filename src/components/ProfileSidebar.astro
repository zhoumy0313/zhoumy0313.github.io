---
import SocialLinks from "@components/SocialLinks.astro";
import { localize, type SiteData } from "@lib/content";
import { withBase, type Locale } from "@lib/paths";
import { ui } from "@i18n/ui";
type Profile = Extract<SiteData, { kind: "profile" }>;
type Social = Extract<SiteData, { kind: "social" }>;
const { profile, social, locale } = Astro.props as { profile: Profile; social: Social; locale: Locale };
const label = (key: keyof typeof ui.profile) => ui.profile[key][locale];
---
<aside class="profile-card">
  <div class="profile-top"><img class="avatar" src={withBase(profile.avatar)} alt={`${localize(profile.name, locale)} avatar`} /><h1>{localize(profile.name, locale)}</h1><p class="status">{localize(profile.position, locale)}</p><p class="motto">{localize(profile.motto, locale)}</p></div>
  <dl class="facts">
    <div class="fact-item"><dt><span class="icon material-symbols-outlined" aria-hidden="true">place</span>{label("location")}</dt><dd>{localize(profile.location, locale)}</dd></div>
    <div class="fact-item"><dt><span class="icon material-symbols-outlined" aria-hidden="true">domain</span>{label("institution")}</dt><dd>{localize(profile.organization, locale)}</dd></div>
    <div class="fact-item"><dt><span class="icon material-symbols-outlined" aria-hidden="true">school</span>{label("specialty")}</dt><dd>{localize(profile.major, locale)}</dd></div>
    <div class="fact-item"><dt><span class="icon material-symbols-outlined" aria-hidden="true">mail</span>{label("email")}</dt><dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd></div>
  </dl>
  <div class="research"><p><span class="title-icon material-symbols-outlined" aria-hidden="true">science</span>{label("research")}</p><ul class="pill-list">{profile.research.map((item) => <li class="pill">{localize(item.label, locale)}</li>)}</ul></div>
  <div class="social-block"><p><span class="title-icon material-symbols-outlined" aria-hidden="true">share</span>{label("social")}</p><SocialLinks items={social.items} /></div>
</aside>
<style>
  .profile-card{align-self:start;background:var(--panel);border:1px solid var(--line);border-radius:var(--card-radius);box-shadow:var(--shadow);padding:clamp(1rem,2vw,1.3rem);position:sticky;top:1rem}.profile-top{display:grid;justify-items:center;text-align:center;gap:.35rem;padding-bottom:1rem;margin-bottom:1rem;border-bottom:1px solid var(--line)}.avatar{aspect-ratio:1;border-radius:.7rem;box-shadow:0 6px 18px oklch(20% .02 248/.08);object-fit:cover;width:5.9rem}h1{font-family:var(--font-serif);font-size:clamp(1.42rem,1.85vw,1.9rem);line-height:1.02;margin:.1rem 0 0}.status{color:oklch(54% .09 235);font-size:.92rem;font-weight:600;margin:0}.motto{color:var(--muted);font-family:var(--font-serif);font-size:.92rem;line-height:1.6;margin:.2rem 0 0}.facts{display:grid;gap:1rem;margin:0}.fact-item{display:grid;gap:.18rem}.facts dt,.research p,.social-block>p{color:var(--accent);display:flex;align-items:center;gap:.5rem;font-size:var(--body-size);font-weight:700;margin:0}.facts dd{margin:0;color:var(--ink);line-height:1.55;padding-left:1.45rem}.icon,.title-icon{display:inline-grid;font-size:1.08rem;line-height:1;place-items:center;opacity:.85}.research{margin-top:.9rem}.research p{margin-bottom:.35rem}.social-block{border-top:1px solid var(--line);margin-top:1.15rem;padding-top:.9rem}.social-block>p{margin-bottom:.65rem}:global(.material-symbols-outlined){font-family:"Material Symbols Outlined";font-variation-settings:"FILL" 0,"wght" 400,"GRAD" 0,"opsz" 20;font-feature-settings:"liga"}@media(max-width:860px){.profile-card{position:static}}
</style>

---
import CollectionList from "@components/CollectionList.astro";
import AwardList from "@components/AwardList.astro";
import EducationTimeline from "@components/EducationTimeline.astro";
import MediaCard from "@components/MediaCard.astro";
import PublicationList from "@components/PublicationList.astro";
import { getProjects, getSiteData, localize, type SiteData } from "@lib/content";
import { renderMarkdown } from "@lib/markdown";
import { withBase, type Locale } from "@lib/paths";
import { linkTypeLabel, sectionLabel, statusLabel, tagLabel, ui } from "@i18n/ui";
type Home = Extract<SiteData, { kind: "homepage" }>;
const { section, locale } = Astro.props as { section: Home["sections"][number]; locale: Locale };
const source = section.source;
const data = source === "projects" ? null : await getSiteData(source);
const projects = source === "projects" ? await getProjects({ featured: section.featuredOnly ? true : undefined, limit: section.limit }) : [];
const formatPeriod = (start: string, end: string | null) => {
  const format = (value: string) => new Intl.DateTimeFormat(locale === "zh" ? "zh-CN" : "en-US", { year: "numeric", month: locale === "zh" ? "2-digit" : "short" }).format(new Date(`${value}-01T00:00:00Z`));
  return `${format(start)} – ${end ? format(end) : ui.present[locale]}`;
};
---
<section class="content-section page-section"><h2 class="section-title">{sectionLabel(source, locale)}</h2>
  {data?.kind === "profile" && <div class="prose" set:html={renderMarkdown(localize(data.about, locale))} />}
  {data?.kind === "education" && <EducationTimeline items={data.items.map((item) => ({ degree: localize(item.degree, locale), school: localize(item.school, locale), period: formatPeriod(item.start, item.end), description: localize(item.description, locale), image: withBase(item.image) }))} />}
  {data?.kind === "publications" && <PublicationList items={data.items.map((item) => ({ title: item.title, venue: item.venue, date: item.year, authors: item.authors.join(", "), status: statusLabel(item.status, locale), image: item.image, links: item.links.map((link) => ({ title: link.label ? localize(link.label, locale) : linkTypeLabel(link.type, locale), url: link.url })) }))} />}
  {data?.kind === "awards" && <AwardList items={data.items.map((item) => ({ title: localize(item.title, locale), issuer: localize(item.issuer, locale), date: item.year, description: localize(item.description, locale), image: withBase(item.image) }))} />}
  {data?.kind === "notes" && <div class="notes-list">{data.items.map((item) => <MediaCard href={item.url} title={localize(item.title, locale)} summary={localize(item.summary, locale)} image={item.image ? withBase(item.image) : undefined} imageAlt={localize(item.title, locale)} external={true} tags={item.tags.map((tag) => tagLabel(tag, locale))} />)}</div>}
  {source === "projects" && <CollectionList projects={projects} locale={locale} />}
</section>

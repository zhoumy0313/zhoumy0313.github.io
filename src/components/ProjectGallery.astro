---
import { localize } from "@lib/content";
import { withBase, type Locale } from "@lib/paths";
type Image = { id: string; src: string; caption: { zh: string; en: string } };
const { images, locale } = Astro.props as { images: Image[]; locale: Locale };
---
<div class="project-gallery">{images.map((image) => <figure><img src={withBase(image.src)} alt={localize(image.caption, locale)} loading="lazy" /><figcaption>{localize(image.caption, locale)}</figcaption></figure>)}</div>
<style>.project-gallery figure{margin:0}.project-gallery figcaption{color:var(--muted);font-size:.9rem;margin-top:.45rem}</style>

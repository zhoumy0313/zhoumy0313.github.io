---
import BaseLayout from "@layouts/BaseLayout.astro"; import MediaCard from "@components/MediaCard.astro"; import { getSiteData, localize } from "@lib/content"; import { withBase,type Locale } from "@lib/paths"; import { tagLabel } from "@i18n/ui";
export function getStaticPaths(){return [{params:{lang:"zh"}},{params:{lang:"en"}}]}; const {lang}=Astro.params as {lang:Locale}; const data=await getSiteData("notes");
---
<BaseLayout title={localize(data.title,lang)} description={localize(data.summary,lang)} locale={lang}><section class="content-section"><h2 class="section-title">{localize(data.title,lang)}</h2><p class="subtle">{localize(data.summary,lang)}</p><div class="notes-list">{data.items.map(i=><MediaCard href={i.url} title={localize(i.title,lang)} summary={localize(i.summary,lang)} image={i.image?withBase(i.image):undefined} imageAlt={localize(i.title,lang)} external={true} tags={i.tags.map(tag=>tagLabel(tag,lang))}/>)}</div></section></BaseLayout>

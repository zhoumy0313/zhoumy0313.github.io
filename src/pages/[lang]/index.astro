---
import SectionRenderer from "@components/SectionRenderer.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getSiteData } from "@lib/content";
import type { Locale } from "@lib/paths";
export function getStaticPaths() { return [{ params: { lang: "zh" } }, { params: { lang: "en" } }]; }
const { lang } = Astro.params as { lang: Locale }; const homepage = await getSiteData("homepage");
---
<BaseLayout locale={lang}>{homepage.sections.map((section) => <SectionRenderer section={section} locale={lang} />)}</BaseLayout>

---
import CollectionList from "@components/CollectionList.astro"; import BaseLayout from "@layouts/BaseLayout.astro"; import { getProjects } from "@lib/content"; import type { Locale } from "@lib/paths"; import { sectionLabel } from "@i18n/ui";
export function getStaticPaths(){return [{params:{lang:"zh"}},{params:{lang:"en"}}]}; const {lang}=Astro.params as {lang:Locale}; const projects=await getProjects(); const title=sectionLabel("projects",lang);
---
<BaseLayout title={title} description={title} locale={lang}><section class="content-section"><h2 class="section-title">{title}</h2><CollectionList projects={projects} locale={lang}/></section></BaseLayout>

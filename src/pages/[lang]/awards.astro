---
import AwardList from "@components/AwardList.astro"; import BaseLayout from "@layouts/BaseLayout.astro"; import { getSiteData, localize } from "@lib/content"; import { withBase,type Locale } from "@lib/paths";
export function getStaticPaths(){return [{params:{lang:"zh"}},{params:{lang:"en"}}]}; const {lang}=Astro.params as {lang:Locale}; const data=await getSiteData("awards");
---
<BaseLayout title={localize(data.title,lang)} description={localize(data.summary,lang)} locale={lang}><section class="content-section"><h2 class="section-title">{localize(data.title,lang)}</h2><p class="subtle">{localize(data.summary,lang)}</p><AwardList items={data.items.map(i=>({title:localize(i.title,lang),issuer:localize(i.issuer,lang),date:i.year,description:localize(i.description,lang),image:withBase(i.image)}))}/></section></BaseLayout>

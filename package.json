{
  "name": "personal-academic-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "content:check": "node --experimental-strip-types scripts/validate-content.ts",
    "media:check": "node --experimental-strip-types scripts/check-media.ts",
    "links:check": "node --experimental-strip-types scripts/check-links.ts",
    "validate": "npm run content:check && npm run media:check && npm run check && npm run build",
    "postinstall": "astro telemetry disable"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "astro": "^7.0.3",
    "marked": "^16.3.0",
    "yaml": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.5.2"
  }
}

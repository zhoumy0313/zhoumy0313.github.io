---
import { localize, type SiteData } from "@lib/content";
import { localizedPath, switchLocalePath, type Locale } from "@lib/paths";
type NavigationData = Extract<SiteData, { kind: "navigation" }>;
type Props = { items: NavigationData["items"]; locale: Locale; currentPath: string };
const { items, locale, currentPath } = Astro.props;
---
<nav class="top-nav" aria-label="Primary navigation">
  {items.map((item) => <a href={item.external ? item.href : localizedPath(locale, item.href)} target={item.external ? "_blank" : undefined} rel={item.external ? "noopener noreferrer" : undefined}>{localize(item.label, locale)}</a>)}
</nav>
<div class="locale-switch" aria-label="Language switcher">
  {locale === "zh" ? <span class="active" aria-current="true">中文</span> : <a href={switchLocalePath(currentPath, "zh")}>中文</a>}
  {locale === "en" ? <span class="active" aria-current="true">English</span> : <a href={switchLocalePath(currentPath, "en")}>English</a>}
</div>
<style>
  .top-nav{align-items:center;display:flex;flex-wrap:wrap;gap:.3rem;justify-content:flex-start;margin-bottom:.35rem;padding-bottom:.55rem;border-bottom:1px solid var(--line)}
  .top-nav a{border-radius:999px;color:var(--muted);font-size:1.02rem;font-weight:600;padding:.5rem .9rem;text-decoration:none}.top-nav a:hover{background:var(--surface-strong);color:var(--accent)}
  .locale-switch{align-items:center;background:oklch(95.8% .005 248);border:1px solid var(--line);border-radius:999px;display:flex;justify-content:flex-end;gap:.15rem;margin-left:auto;margin-top:.35rem;padding:.18rem;width:fit-content}
  .locale-switch a,.locale-switch span{border-radius:999px;color:oklch(54% .008 248);display:inline-flex;font-size:.82rem;font-weight:700;line-height:1;padding:.45rem .65rem;text-decoration:none}.locale-switch a:hover{background:oklch(97.2% .004 248);color:oklch(38% .025 248)}.locale-switch .active{background:oklch(91.8% .035 235);color:oklch(36% .055 235)}
  @media(max-width:860px){.top-nav{justify-content:flex-start;margin:.55rem 0 .35rem}}
</style>

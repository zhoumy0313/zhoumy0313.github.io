---
import { getCollection } from "astro:content"; import ProjectLayout from "@layouts/ProjectLayout.astro"; import type { Locale } from "@lib/paths";
export async function getStaticPaths(){const projects=await getCollection("projects"); return projects.flatMap(project=>(["zh","en"] as const).map(lang=>({params:{lang,slug:project.data.slug},props:{project,locale:lang}})))} const {project,locale}=Astro.props;
---
<ProjectLayout project={project} locale={locale as Locale}/>
